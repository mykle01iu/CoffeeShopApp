<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:fillViewport="true">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingTop="8dp"
        android:paddingEnd="24dp"
        android:paddingBottom="8dp">
        <EditText
            android:id="@+id/input_product_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Tên sản phẩm"
            android:inputType="textCapSentences"
            android:maxLines="1" />
        <EditText
            android:id="@+id/input_product_price"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Giá (VNĐ)"
            android:inputType="numberDecimal"
            android:maxLines="1" />
        <EditText
            android:id="@+id/input_product_description"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="top"
            android:hint="Mô tả"
            android:inputType="textCapSentences|textMultiLine"
            android:minLines="2" />
        <TextView
            android:id="@+id/choose_product_image"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginTop="4dp"
            android:background="@drawable/filter_normal"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:text="Chọn ảnh từ thư viện thiết bị"
            android:textColor="@color/coffee"
            android:textStyle="bold" />
        <ImageView
            android:id="@+id/product_image_preview"
            android:layout_width="match_parent"
            android:layout_height="150dp"
            android:layout_marginTop="10dp"
            android:background="@drawable/product_placeholder"
            android:contentDescription="Ảnh xem trước sản phẩm"
            android:scaleType="centerCrop"
            android:src="@drawable/splash" />
    </LinearLayout>
</ScrollView>
