<resources>
    <style name="Theme.CoffeeShop" parent="Theme.MaterialComponents.Light.NoActionBar">
        <item name="colorPrimary">@color/coffee_brown</item>
        <item name="colorPrimaryVariant">@color/coffee_brown_dark</item>
        <item name="colorOnPrimary">@color/coffee_cream</item>
        <item name="colorSecondary">@color/coffee_accent</item>
        <item name="colorOnSecondary">@color/coffee_cream</item>
        <item name="android:fontFamily">sans</item>
        <item name="colorAccent">@color/coffee_accent</item>
        <item name="android:colorAccent">@color/coffee_accent</item>
        <item name="android:statusBarColor">@color/coffee_cream</item>
        <item name="android:navigationBarColor">@color/coffee_cream</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
        <item name="android:windowActionModeOverlay">true</item>
        <item name="android:windowBackground">@color/coffee_cream</item>
    </style>

    <style name="CategoryChip">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">@dimen/chip_height</item>
        <item name="android:layout_marginEnd">@dimen/space_2</item>
        <item name="android:background">@drawable/bg_category_chip</item>
        <item name="android:gravity">center</item>
        <item name="android:paddingStart">16dp</item>
        <item name="android:paddingEnd">16dp</item>
        <item name="android:textColor">@color/coffee_muted</item>
        <item name="android:textSize">13sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
    </style>

    <style name="CategoryChip.Selected" parent="CategoryChip">
        <item name="android:background">@drawable/bg_category_chip_selected</item>
        <item name="android:textColor">@color/coffee_surface</item>
        <item name="android:textStyle">bold</item>
    </style>
    <style name="BottomNavigationItem">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">match_parent</item>
        <item name="android:layout_weight">1</item>
        <item name="android:gravity">center</item>
        <item name="android:background">?android:attr/selectableItemBackground</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
        <item name="android:orientation">vertical</item>
    </style>
    <style name="BottomNavigationIcon">
        <item name="android:layout_width">22dp</item>
        <item name="android:layout_height">22dp</item>
        <item name="android:contentDescription">@null</item>
    </style>
    <style name="BottomNavigationLabel">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textSize">11sp</item>
    </style>
</resources>
