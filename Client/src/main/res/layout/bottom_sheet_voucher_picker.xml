<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_product_card"
    android:orientation="vertical"
    android:paddingStart="20dp"
    android:paddingTop="12dp"
    android:paddingEnd="20dp"
    android:paddingBottom="24dp">

    <!-- Drag Handle -->
    <View
        android:layout_width="40dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="16dp"
        android:background="@drawable/bg_splash_progress_dot" />

    <!-- Top Header -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Chọn hoặc nhập mã Voucher"
        android:textColor="@color/coffee_text"
        android:textSize="20sp"
        android:textStyle="bold" />

    <!-- Code Input Box & Apply Button -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <EditText
            android:id="@+id/pickerVoucherInput"
            android:layout_width="0dp"
            android:layout_height="50dp"
            android:layout_weight="1"
            android:background="@drawable/bg_input"
            android:hint="Nhập mã voucher (ví dụ: GIAM20)"
            android:inputType="textCapCharacters"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:textColor="@color/coffee_text"
            android:textColorHint="@color/coffee_muted"
            android:textSize="14sp" />

        <Button
            android:id="@+id/btnPickerApply"
            android:layout_width="wrap_content"
            android:layout_height="50dp"
            android:layout_marginStart="10dp"
            android:background="@drawable/bg_primary_button"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:text="Áp dụng"
            android:textAllCaps="false"
            android:textColor="@color/coffee_surface"
            android:textSize="14sp"
            android:textStyle="bold" />
    </LinearLayout>

    <TextView
        android:id="@+id/pickerVoucherError"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:textColor="@color/coffee_error"
        android:textSize="12sp"
        android:visibility="gone" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:text="Danh sách Voucher của bạn"
        android:textColor="@color/coffee_brown"
        android:textSize="13sp"
        android:textStyle="bold" />

    <!-- Vouchers RecyclerView & Empty State -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="260dp"
        android:layout_marginTop="8dp">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/pickerRecyclerView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:overScrollMode="never" />

        <LinearLayout
            android:id="@+id/pickerEmptyView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Không có voucher nào phù hợp"
                android:textColor="@color/coffee_muted"
                android:textSize="14sp" />
        </LinearLayout>
    </FrameLayout>
</LinearLayout>
