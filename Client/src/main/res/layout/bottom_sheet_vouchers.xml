<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_product_card"
    android:orientation="vertical"
    android:paddingStart="20dp"
    android:paddingTop="12dp"
    android:paddingEnd="20dp"
    android:paddingBottom="24dp">

    <!-- Drag Handle -->
    <View
        android:layout_width="40dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="16dp"
        android:background="@drawable/bg_splash_progress_dot" />

    <!-- Top Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Voucher của tôi"
                android:textColor="@color/coffee_text"
                android:textSize="20sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/voucherHeaderSubtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textColor="@color/coffee_muted"
                android:textSize="13sp"
                tools:text="2 mã có hiệu lực" />
        </LinearLayout>
    </LinearLayout>

    <!-- Filter Chips Row -->
    <LinearLayout
        android:id="@+id/voucherFilterChipsContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/chipVoucherActive"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:layout_marginEnd="8dp"
            android:background="@drawable/bg_category_chip_selected"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:textColor="@color/coffee_surface"
            android:textSize="13sp"
            android:textStyle="bold"
            tools:text="Có thể dùng (2)" />

        <TextView
            android:id="@+id/chipVoucherUsed"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:layout_marginEnd="8dp"
            android:background="@drawable/bg_category_chip"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:textColor="@color/coffee_muted"
            android:textSize="13sp"
            android:textStyle="bold"
            tools:text="Đã dùng (1)" />

        <TextView
            android:id="@+id/chipVoucherExpired"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:background="@drawable/bg_category_chip"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:textColor="@color/coffee_muted"
            android:textSize="13sp"
            android:textStyle="bold"
            tools:text="Hết hạn (1)" />
    </LinearLayout>

    <!-- Vouchers RecyclerView & Empty State -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="300dp"
        android:layout_marginTop="14dp">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/vouchersRecyclerView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:overScrollMode="never" />

        <LinearLayout
            android:id="@+id/vouchersEmptyView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="vertical"
            android:visibility="gone">

            <ImageView
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_favorite_border"
                android:tint="@color/coffee_muted" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="Chưa có voucher nào"
                android:textColor="@color/coffee_muted"
                android:textSize="14sp"
                android:textStyle="bold" />
        </LinearLayout>
    </FrameLayout>

    <!-- Fixed Bottom Action -->
    <Button
        android:id="@+id/btnCloseVoucherSheet"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginTop="16dp"
        android:background="@drawable/bg_filter_button"
        android:text="Đóng"
        android:textAllCaps="false"
        android:textColor="@color/coffee_brown"
        android:textSize="14sp"
        android:textStyle="bold" />
</LinearLayout>
