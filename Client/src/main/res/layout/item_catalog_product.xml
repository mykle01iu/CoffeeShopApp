<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical"
    android:background="@drawable/bg_product_card" android:padding="12dp" android:layout_marginBottom="10dp" tools:showIn="@layout/activity_product_list">
    <ImageView android:id="@+id/productImage" android:layout_width="96dp" android:layout_height="96dp" android:scaleType="centerCrop" android:background="@drawable/bg_drink_iced" tools:src="@drawable/nauda" android:contentDescription="@null" />
    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:paddingStart="14dp">
        <TextView android:id="@+id/productName" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="@color/coffee_text" android:textSize="16sp" android:textStyle="bold" tools:text="Nâu đá" />
        <TextView android:id="@+id/productCategory" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="@color/coffee_muted" android:textSize="13sp" tools:text="Cà phê" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal" android:paddingTop="8dp">
            <TextView android:id="@+id/productPrice" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:textColor="@color/coffee_accent" android:textSize="16sp" android:textStyle="bold" tools:text="29.000đ" />
            <TextView android:id="@+id/productRating" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="@color/coffee_accent" android:textSize="13sp" tools:text="★★★★★ 4.9 (128)" />
        </LinearLayout>
    </LinearLayout>
    <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="vertical">
        <ImageButton android:id="@+id/productFavorite" android:layout_width="36dp" android:layout_height="36dp" android:background="?android:attr/selectableItemBackgroundBorderless" android:src="@drawable/ic_favorite_border" android:tint="@color/coffee_accent" android:contentDescription="@null" android:padding="6dp" />
        <TextView android:id="@+id/productAdd" android:layout_width="36dp" android:layout_height="36dp" android:layout_marginTop="8dp" android:background="@drawable/bg_primary_button" android:gravity="center" android:text="+" android:textColor="@color/coffee_surface" android:textSize="24sp" android:textStyle="bold" android:contentDescription="@string/options_add_description" />
    </LinearLayout>
</LinearLayout>
