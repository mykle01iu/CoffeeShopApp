<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/coffee_cream">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:fillViewport="true"
            android:overScrollMode="never">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="20dp"
                android:paddingTop="16dp"
                android:paddingEnd="20dp"
                android:paddingBottom="24dp">

                <!-- Top Bar -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageButton
                        android:id="@+id/paymentMethodsBack"
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:background="@drawable/bg_filter_button"
                        android:contentDescription="@string/back_button_description"
                        android:padding="12dp"
                        android:src="@drawable/ic_arrow_back"
                        app:tint="@color/coffee_brown" />

                    <TextView
                        android:id="@+id/paymentMethodsTitle"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="16dp"
                        android:layout_weight="1"
                        android:text="@string/payment_methods_title"
                        android:textColor="@color/coffee_text"
                        android:textSize="22sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <!-- Payment Methods List Container -->
                <LinearLayout
                    android:id="@+id/paymentMethodsContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:orientation="vertical" />
            </LinearLayout>
        </ScrollView>

        <!-- Bottom Actions Container -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/coffee_surface"
            android:elevation="8dp"
            android:orientation="vertical"
            android:padding="16dp">

            <Button
                android:id="@+id/btnLinkWallet"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:background="@drawable/bg_primary_button"
                android:text="@string/payment_link_wallet_button"
                android:textAllCaps="false"
                android:textColor="@color/coffee_surface"
                android:textSize="14sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnAddCard"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_welcome_secondary_button"
                android:text="@string/payment_add_card_button"
                android:textAllCaps="false"
                android:textColor="@color/coffee_brown"
                android:textSize="14sp"
                android:textStyle="bold" />
        </LinearLayout>

    </LinearLayout>
</FrameLayout>
