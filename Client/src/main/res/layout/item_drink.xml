<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/drinkCard"
    android:layout_width="176dp"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_product_card"
    android:orientation="vertical"
    android:padding="8dp">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="164dp"
        android:background="@drawable/bg_drink_iced"
        android:clipToOutline="true">

        <ImageView
            android:id="@+id/drinkImage"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:contentDescription="@null"
            android:scaleType="centerCrop" />

        <TextView
            android:id="@+id/drinkRating"
            android:layout_width="wrap_content"
            android:layout_height="26dp"
            android:layout_gravity="top|start"
            android:layout_margin="8dp"
            android:background="@drawable/bg_rating_badge"
            android:gravity="center"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:textColor="@color/coffee_text"
            android:textSize="11sp"
            android:textStyle="bold" />

        <ImageButton
            android:id="@+id/favoriteDrinkButton"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_gravity="top|end"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/home_show_favorites"
            android:padding="8dp"
            android:src="@drawable/ic_favorite_border"
            android:tint="@color/coffee_text" />
    </FrameLayout>

    <TextView
        android:id="@+id/drinkName"
        android:layout_width="match_parent"
        android:layout_height="22dp"
        android:layout_marginTop="8dp"
        android:ellipsize="end"
        android:gravity="center_vertical"
        android:includeFontPadding="false"
        android:maxLines="1"
        android:textColor="@color/coffee_text"
        android:textSize="14sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/drinkDescription"
        android:layout_width="match_parent"
        android:layout_height="18dp"
        android:layout_marginTop="2dp"
        android:ellipsize="end"
        android:gravity="center_vertical"
        android:includeFontPadding="false"
        android:maxLines="1"
        android:text="Đá · Size M · 350 ml"
        android:textColor="@color/coffee_muted"
        android:textSize="11sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="4dp"
        android:layout_weight="1"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/drinkPrice"
            android:layout_width="0dp"
            android:layout_height="22dp"
            android:layout_weight="1"
            android:gravity="center_vertical"
            android:includeFontPadding="false"
            android:textColor="@color/coffee_text"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/addDrinkButton"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="@drawable/bg_add_button"
            android:clickable="true"
            android:contentDescription="@string/add_iced_drink"
            android:focusable="true"
            android:gravity="center"
            android:text="+"
            android:textColor="@color/coffee_surface"
            android:textSize="20sp"
            android:textStyle="bold" />
    </LinearLayout>
</LinearLayout>
