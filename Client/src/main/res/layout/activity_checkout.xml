<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/coffee_cream"
    android:fillViewport="true"
    android:overScrollMode="never">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingTop="20dp"
        android:paddingEnd="24dp"
        android:paddingBottom="32dp">

        <!-- Top Bar -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageButton
                android:id="@+id/checkoutBack"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="@drawable/bg_filter_button"
                android:contentDescription="@string/back_button_description"
                android:padding="12dp"
                android:src="@drawable/ic_arrow_back"
                android:tint="@color/coffee_brown" />

            <TextView
                android:id="@+id/checkoutTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_weight="1"
                android:text="@string/checkout_screen_title"
                android:textColor="@color/coffee_text"
                android:textSize="22sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- 1. Địa chỉ giao hàng -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:layout_marginStart="4dp"
            android:text="@string/checkout_address_label"
            android:textColor="@color/coffee_brown"
            android:textSize="12sp"
            android:textStyle="bold" />

        <LinearLayout
            android:id="@+id/checkoutAddressCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:background="@drawable/bg_product_card"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="16dp">

            <ImageView
                android:id="@+id/checkoutAddressIcon"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_location"
                android:tint="@color/coffee_brown" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/checkoutAddressText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:textColor="@color/coffee_text"
                    android:textSize="14sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>

        <TextView
            android:id="@+id/checkoutAddressWarning"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:text="@string/delivery_missing"
            android:textColor="@color/coffee_error"
            android:textSize="12sp"
            android:visibility="gone" />

        <!-- 2. Phương thức thanh toán -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:layout_marginStart="4dp"
            android:text="@string/checkout_payment_label"
            android:textColor="@color/coffee_brown"
            android:textSize="12sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:background="@drawable/bg_product_card"
            android:orientation="vertical"
            android:padding="12dp">

            <RadioGroup
                android:id="@+id/paymentMethodGroup"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <RadioButton
                    android:id="@+id/radioCash"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:buttonTint="@color/coffee_accent"
                    android:checked="true"
                    android:text="@string/checkout_pay_cash"
                    android:textColor="@color/coffee_text"
                    android:textSize="14sp" />

                <RadioButton
                    android:id="@+id/radioWallet"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:buttonTint="@color/coffee_accent"
                    android:text="@string/checkout_pay_wallet"
                    android:textColor="@color/coffee_text"
                    android:textSize="14sp" />

                <RadioButton
                    android:id="@+id/radioCard"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:buttonTint="@color/coffee_accent"
                    android:text="@string/checkout_pay_card"
                    android:textColor="@color/coffee_text"
                    android:textSize="14sp" />
            </RadioGroup>
        </LinearLayout>

        <!-- 3. Ghi chú cho quán -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:layout_marginStart="4dp"
            android:text="@string/checkout_note_label"
            android:textColor="@color/coffee_brown"
            android:textSize="12sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/checkoutNoteInput"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="6dp"
            android:background="@drawable/bg_input"
            android:hint="@string/checkout_note_hint"
            android:inputType="text"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:textColor="@color/coffee_text"
            android:textColorHint="@color/coffee_muted"
            android:textSize="14sp" />

        <!-- 4. Voucher ưu đãi -->
        <LinearLayout
            android:id="@+id/checkoutVoucherRow"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="20dp"
            android:background="@drawable/bg_product_card"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="16dp"
            android:paddingEnd="16dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/checkout_voucher_label"
                android:textColor="@color/coffee_text"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/checkoutVoucherText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/checkout_voucher_select"
                android:textColor="@color/coffee_brown"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- 5. Tóm tắt đơn hàng -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:layout_marginStart="4dp"
            android:text="@string/checkout_summary_title"
            android:textColor="@color/coffee_brown"
            android:textSize="12sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:background="@drawable/bg_product_card"
            android:orientation="vertical"
            android:padding="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/cart_subtotal_label"
                    android:textColor="@color/coffee_muted"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/summarySubtotalText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/coffee_text"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    tools:text="45.000đ" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/checkout_shipping_label"
                    android:textColor="@color/coffee_muted"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/summaryShippingText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="15.000đ"
                    android:textColor="@color/coffee_text"
                    android:textSize="14sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/checkout_discount_label"
                    android:textColor="@color/coffee_muted"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/summaryDiscountText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="-0đ"
                    android:textColor="#43A047"
                    android:textSize="14sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="12dp"
                android:layout_marginBottom="12dp"
                android:background="@color/coffee_border" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/checkout_total_label"
                    android:textColor="@color/coffee_text"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/summaryTotalText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/coffee_accent"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    tools:text="60.000đ" />
            </LinearLayout>
        </LinearLayout>

        <!-- Place order -->
        <Button
            android:id="@+id/btnPlaceOrder"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginTop="28dp"
            android:background="@drawable/bg_primary_button"
            android:text="@string/checkout_place_order_button"
            android:textAllCaps="false"
            android:textColor="@color/coffee_surface"
            android:textSize="16sp"
            android:textStyle="bold" />
    </LinearLayout>
</ScrollView>
