<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/coffee_cream"
    android:orientation="vertical">

    <!-- Top Bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="24dp"
        android:paddingTop="8dp"
        android:paddingEnd="24dp">

        <ImageButton
            android:id="@+id/ordersBack"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/bg_filter_button"
            android:contentDescription="@string/back_button_description"
            android:padding="12dp"
            android:src="@drawable/ic_arrow_back"
            android:tint="@color/coffee_brown" />

        <TextView
            android:id="@+id/ordersTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_weight="1"
            android:text="Lịch sử đơn hàng"
            android:textColor="@color/coffee_text"
            android:textSize="22sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Filter Chips Bar -->
    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:clipToPadding="false"
        android:overScrollMode="never"
        android:paddingStart="20dp"
        android:paddingTop="12dp"
        android:paddingEnd="20dp"
        android:paddingBottom="12dp"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/chipOrderAll"
                style="@style/CategoryChip.Selected"
                android:text="Tất cả" />

            <TextView
                android:id="@+id/chipOrderPreparing"
                style="@style/CategoryChip"
                android:text="Đang chuẩn bị" />

            <TextView
                android:id="@+id/chipOrderCompleted"
                style="@style/CategoryChip"
                android:text="Hoàn thành" />

            <TextView
                android:id="@+id/chipOrderCancelled"
                style="@style/CategoryChip"
                android:text="Đã hủy" />
        </LinearLayout>
    </HorizontalScrollView>

    <!-- Main Orders List & Empty State -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/ordersRecyclerView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingStart="20dp"
            android:paddingTop="8dp"
            android:paddingEnd="20dp"
            android:paddingBottom="24dp" />

        <!-- Empty State -->
        <LinearLayout
            android:id="@+id/ordersEmptyView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="32dp"
            android:visibility="gone">

            <ImageView
                android:layout_width="72dp"
                android:layout_height="72dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_orders"
                android:tint="@color/coffee_brown" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="Bạn chưa có đơn hàng nào"
                android:textColor="@color/coffee_text"
                android:textSize="20sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnOrderNow"
                android:layout_width="wrap_content"
                android:layout_height="52dp"
                android:layout_marginTop="24dp"
                android:background="@drawable/bg_primary_button"
                android:paddingStart="24dp"
                android:paddingEnd="24dp"
                android:text="Đặt món ngay"
                android:textAllCaps="false"
                android:textColor="@color/coffee_surface"
                android:textSize="14sp"
                android:textStyle="bold" />
        </LinearLayout>
    </FrameLayout>
</LinearLayout>
