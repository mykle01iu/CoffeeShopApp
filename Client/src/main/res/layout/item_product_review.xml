<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:background="@drawable/bg_product_card" android:padding="14dp" android:layout_marginBottom="10dp">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal">
        <TextView android:id="@+id/reviewAuthor" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:textColor="@color/coffee_text" android:textStyle="bold" android:textSize="15sp" />
        <TextView android:id="@+id/reviewDate" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="@color/coffee_muted" android:textSize="12sp" />
    </LinearLayout>
    <TextView android:id="@+id/reviewStars" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="@color/coffee_accent" android:textSize="14sp" android:layout_marginTop="4dp" />
    <TextView android:id="@+id/reviewComment" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="@color/coffee_muted" android:textSize="14sp" android:lineSpacingExtra="3dp" android:layout_marginTop="4dp" />
</LinearLayout>
