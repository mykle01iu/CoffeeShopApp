<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/coffee_cream"
    android:fillViewport="true"
    android:overScrollMode="never">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingTop="28dp"
        android:paddingEnd="24dp"
        android:paddingBottom="18dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:gravity="center"
                android:letterSpacing="0.16"
                android:text="@string/splash_eyebrow"
                android:textColor="@color/coffee_brown"
                android:textSize="12sp"
                android:textStyle="bold" />

            <ImageView
                android:id="@+id/splashLogo"
                android:layout_width="100dp"
                android:layout_height="100dp"
                android:contentDescription="@string/app_name"
                android:scaleType="fitCenter"
                android:src="@drawable/logo_moc_mien_transparent" />

            <TextView
                android:id="@+id/splashBrandName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center"
                android:includeFontPadding="false"
                android:lineSpacingMultiplier="1.2"
                android:text="@string/splash_brand_name"
                android:textColor="@color/coffee_text"
                android:textSize="38sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:gravity="center"
                android:letterSpacing="0.32"
                android:text="@string/splash_coffee_word"
                android:textColor="@color/coffee_muted"
                android:textSize="10sp" />

            <View
                android:layout_width="24dp"
                android:layout_height="1dp"
                android:layout_marginTop="10dp"
                android:background="@color/coffee_accent" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:gravity="center"
                android:lineSpacingMultiplier="1.5"
                android:text="@string/splash_tagline"
                android:textColor="@color/coffee_muted"
                android:textSize="16sp" />
        </LinearLayout>

        <Space
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <ImageView
            android:id="@+id/splashCoffeePhoto"
            android:layout_width="match_parent"
            android:layout_height="160dp"
            android:layout_marginTop="24dp"
            android:background="@drawable/bg_product_card"
            android:clipToOutline="true"
            android:contentDescription="@string/splash_coffee_photo_description"
            android:scaleType="centerCrop"
            android:src="@drawable/coffee_brand_photo" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center"
            android:letterSpacing="0.08"
            android:text="@string/splash_footer"
            android:textColor="@color/coffee_brown"
            android:textSize="12sp"
            android:textStyle="bold" />
    </LinearLayout>
</ScrollView>
