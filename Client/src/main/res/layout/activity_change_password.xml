<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/coffee_cream"
    android:fillViewport="true"
    android:overScrollMode="never">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingTop="20dp"
        android:paddingEnd="24dp"
        android:paddingBottom="32dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageButton
                android:id="@+id/changePasswordBack"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="@drawable/bg_filter_button"
                android:contentDescription="@string/back_button_description"
                android:padding="12dp"
                android:src="@drawable/ic_arrow_back"
                android:tint="@color/coffee_brown" />

            <TextView
                android:id="@+id/changePasswordTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_weight="1"
                android:text="@string/change_password_title"
                android:textColor="@color/coffee_text"
                android:textSize="22sp"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:background="@drawable/bg_product_card"
            android:orientation="vertical"
            android:padding="20dp">

            <!-- Ô 1: Mật khẩu hiện tại -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/current_password_label"
                android:textColor="@color/coffee_text"
                android:textSize="13sp"
                android:textStyle="bold" />

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="6dp"
                android:background="@drawable/bg_input"
                android:paddingStart="14dp"
                android:paddingEnd="10dp">

                <EditText
                    android:id="@+id/currentPasswordInput"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_toStartOf="@id/currentPasswordToggle"
                    android:background="@null"
                    android:hint="Nhập mật khẩu hiện tại"
                    android:imeOptions="actionNext"
                    android:inputType="textPassword"
                    android:textColor="@color/coffee_text"
                    android:textColorHint="@color/coffee_muted"
                    android:textSize="14sp" />

                <ImageButton
                    android:id="@+id/currentPasswordToggle"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:layout_alignParentEnd="true"
                    android:layout_centerVertical="true"
                    android:background="?android:attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@null"
                    android:padding="6dp"
                    android:src="@drawable/ic_visibility"
                    android:tint="@color/coffee_muted" />
            </RelativeLayout>

            <TextView
                android:id="@+id/currentPasswordError"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textColor="@color/coffee_error"
                android:textSize="12sp"
                android:visibility="gone" />

            <!-- Ô 2: Mật khẩu mới -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:text="@string/new_password_label"
                android:textColor="@color/coffee_text"
                android:textSize="13sp"
                android:textStyle="bold" />

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="6dp"
                android:background="@drawable/bg_input"
                android:paddingStart="14dp"
                android:paddingEnd="10dp">

                <EditText
                    android:id="@+id/newPasswordInput"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_toStartOf="@id/newPasswordToggle"
                    android:background="@null"
                    android:hint="Tối thiểu 8 ký tự (chữ &amp; số)"
                    android:imeOptions="actionNext"
                    android:inputType="textPassword"
                    android:textColor="@color/coffee_text"
                    android:textColorHint="@color/coffee_muted"
                    android:textSize="14sp" />

                <ImageButton
                    android:id="@+id/newPasswordToggle"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:layout_alignParentEnd="true"
                    android:layout_centerVertical="true"
                    android:background="?android:attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@null"
                    android:padding="6dp"
                    android:src="@drawable/ic_visibility"
                    android:tint="@color/coffee_muted" />
            </RelativeLayout>

            <TextView
                android:id="@+id/newPasswordError"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textColor="@color/coffee_error"
                android:textSize="12sp"
                android:visibility="gone" />

            <!-- Thanh độ mạnh mật khẩu -->
            <LinearLayout
                android:id="@+id/strengthContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:visibility="gone">

                <ProgressBar
                    android:id="@+id/strengthProgressBar"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="0dp"
                    android:layout_height="6dp"
                    android:layout_weight="1"
                    android:max="100"
                    android:progress="0"
                    android:progressDrawable="@drawable/bg_splash_progress_active" />

                <TextView
                    android:id="@+id/strengthText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:textColor="@color/coffee_muted"
                    android:textSize="12sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Ô 3: Nhập lại mật khẩu mới -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:text="@string/confirm_password_label"
                android:textColor="@color/coffee_text"
                android:textSize="13sp"
                android:textStyle="bold" />

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="6dp"
                android:background="@drawable/bg_input"
                android:paddingStart="14dp"
                android:paddingEnd="10dp">

                <EditText
                    android:id="@+id/confirmPasswordInput"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_toStartOf="@id/confirmPasswordToggle"
                    android:background="@null"
                    android:hint="Xác nhận mật khẩu mới"
                    android:imeOptions="actionDone"
                    android:inputType="textPassword"
                    android:textColor="@color/coffee_text"
                    android:textColorHint="@color/coffee_muted"
                    android:textSize="14sp" />

                <ImageButton
                    android:id="@+id/confirmPasswordToggle"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:layout_alignParentEnd="true"
                    android:layout_centerVertical="true"
                    android:background="?android:attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@null"
                    android:padding="6dp"
                    android:src="@drawable/ic_visibility"
                    android:tint="@color/coffee_muted" />
            </RelativeLayout>

            <TextView
                android:id="@+id/confirmPasswordError"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textColor="@color/coffee_error"
                android:textSize="12sp"
                android:visibility="gone" />

            <!-- Nút Cập nhật mật khẩu -->
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp">

                <Button
                    android:id="@+id/updatePasswordButton"
                    android:layout_width="match_parent"
                    android:layout_height="54dp"
                    android:background="@drawable/bg_primary_button"
                    android:enabled="false"
                    android:text="@string/update_password_button"
                    android:textAllCaps="false"
                    android:textColor="@color/coffee_surface"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <ProgressBar
                    android:id="@+id/loadingProgressBar"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:layout_gravity="center"
                    android:indeterminateTint="@color/coffee_surface"
                    android:visibility="gone" />
            </FrameLayout>
        </LinearLayout>
    </LinearLayout>
</ScrollView>
