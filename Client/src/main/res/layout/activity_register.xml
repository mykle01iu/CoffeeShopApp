<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/coffee_cream"
    android:fillViewport="true"
    android:overScrollMode="never">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="142dp">

            <ImageView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="@string/splash_background_description"
                android:scaleType="centerCrop"
                android:src="@drawable/coffee_brand_photo" />

            <View
                android:layout_width="match_parent"
                android:layout_height="92dp"
                android:layout_gravity="top"
                android:background="@drawable/bg_auth_photo_overlay" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="top"
                android:layout_marginStart="16dp"
                android:layout_marginTop="10dp"
                android:layout_marginEnd="20dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageButton
                    android:id="@+id/registerBackButton"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:background="?android:attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/back_button_description"
                    android:padding="10dp"
                    android:src="@drawable/ic_arrow_back"
                    android:tint="@color/coffee_surface" />

                <ImageView
                    android:layout_width="34dp"
                    android:layout_height="34dp"
                    android:layout_marginStart="8dp"
                    android:contentDescription="@string/app_name"
                    android:src="@drawable/logo_moc_mien_transparent" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/registerBrandText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/login_brand_name"
                        android:textColor="@color/coffee_surface"
                        android:textSize="18sp"
                        android:includeFontPadding="false" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:letterSpacing="0.22"
                        android:text="@string/splash_coffee_word"
                        android:textColor="@color/coffee_surface"
                        android:textSize="8sp" />
                </LinearLayout>
            </LinearLayout>
        </FrameLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="24dp"
            android:paddingTop="14dp"
            android:paddingEnd="24dp"
            android:paddingBottom="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="82dp"
                android:background="@drawable/bg_promo_banner"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="16dp"
                android:paddingEnd="14dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/register_offer_eyebrow"
                        android:textColor="@color/coffee_surface"
                        android:textSize="10sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="@string/register_offer_text"
                        android:textColor="@color/coffee_surface"
                        android:textSize="13sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <TextView
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:background="@drawable/bg_promo_badge"
                    android:gravity="center"
                    android:text="-20%"
                    android:textColor="@color/coffee_brown_dark"
                    android:textSize="13sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <TextView
                android:id="@+id/registerTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:includeFontPadding="false"
                android:lineSpacingMultiplier="1.2"
                android:text="@string/register_title"
                android:textColor="@color/coffee_text"
                android:textSize="32sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="10dp"
                android:lineSpacingMultiplier="1.4"
                android:text="@string/register_subtitle"
                android:textColor="@color/coffee_muted"
                android:textSize="13sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="5dp"
                android:text="@string/name_hint"
                android:textColor="@color/coffee_text"
                android:textSize="13sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/nameInput"
                android:layout_width="match_parent"
                android:layout_height="@dimen/control_height"
                android:autofillHints="name"
                android:background="@drawable/bg_input"
                android:hint="@string/name_hint"
                android:inputType="textPersonName"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:singleLine="true"
                android:textColor="@color/coffee_text"
                android:textColorHint="@color/coffee_muted"
                android:textSize="14sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="9dp"
                android:layout_marginBottom="5dp"
                android:text="@string/register_identifier_label"
                android:textColor="@color/coffee_text"
                android:textSize="13sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/registerEmailInput"
                android:layout_width="match_parent"
                android:layout_height="@dimen/control_height"
                android:autofillHints="emailAddress,phone"
                android:background="@drawable/bg_input"
                android:hint="@string/register_identifier_hint"
                android:inputType="text"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:singleLine="true"
                android:textColor="@color/coffee_text"
                android:textColorHint="@color/coffee_muted"
                android:textSize="14sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="9dp"
                android:layout_marginBottom="5dp"
                android:text="@string/password_label"
                android:textColor="@color/coffee_text"
                android:textSize="13sp"
                android:textStyle="bold" />

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="@dimen/control_height">

                <EditText
                    android:id="@+id/registerPasswordInput"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:autofillHints="newPassword"
                    android:background="@drawable/bg_input"
                    android:hint="@string/register_password_hint"
                    android:inputType="textPassword"
                    android:paddingStart="14dp"
                    android:paddingEnd="56dp"
                    android:singleLine="true"
                    android:textColor="@color/coffee_text"
                    android:textColorHint="@color/coffee_muted"
                    android:textSize="14sp" />

                <ImageButton
                    android:id="@+id/registerPasswordVisibilityButton"
                    android:layout_width="48dp"
                    android:layout_height="match_parent"
                    android:layout_gravity="end|center_vertical"
                    android:background="?android:attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/show_password"
                    android:padding="14dp"
                    android:src="@drawable/ic_visibility"
                    android:tint="@color/coffee_muted" />
            </FrameLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:text="@string/auth_password_hint_rule"
                android:textColor="@color/coffee_muted"
                android:textSize="11sp" />

            <CheckBox
                android:id="@+id/termsCheckBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="7dp"
                android:buttonTint="@color/coffee_brown"
                android:minHeight="48dp"
                android:text="@string/register_terms_agreement"
                android:textColor="@color/coffee_muted"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/registerErrorText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textColor="#B3261E"
                android:textSize="12sp"
                android:visibility="gone" />

            <Button
                android:id="@+id/registerButton"
                android:layout_width="match_parent"
                android:layout_height="@dimen/control_height"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_primary_button"
                android:gravity="center"
                android:text="@string/register_create_button"
                android:textAllCaps="false"
                android:textColor="@color/coffee_surface"
                android:textSize="16sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="44dp"
                android:layout_gravity="center"
                android:gravity="center"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/has_account"
                    android:textColor="@color/coffee_muted"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/loginAction"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:padding="4dp"
                    android:text="@string/login_button"
                    android:textColor="@color/coffee_brown"
                    android:textSize="12sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</ScrollView>
